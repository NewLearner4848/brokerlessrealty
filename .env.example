# ============================================================================
#  Root deployment config — used by docker-compose.yml
#  Copy to ".env" and edit before deploying:  cp .env.example .env
# ============================================================================

# Public domain that serves the React frontend (no protocol, no www).
FRONTEND_DOMAIN=brokerlessrealty.com

# Public domain that serves the backend API.
BACKEND_DOMAIN=backend.brokerlessrealty.com

# Email address Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=admin@brokerlessrealty.com

# API base URL baked into the frontend bundle at build time.
# Must be the public HTTPS URL of the backend.
VITE_API_BASE_URL=https://backend.brokerlessrealty.com
