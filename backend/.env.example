PORT=3001
JWT_SECRET=change_me_to_a_long_random_string

# Node Environment
NODE_ENV=production

# SQLite database path. Inside Docker this points at a mounted volume so data
# persists across rebuilds. Outside Docker, leave unset to use the repo-local file.
DB_PATH=/app/data/brokerless.sqlite

# Email Notification Configuration (used when SMTP is not configured in the
# admin panel). Required to send contact / rent-inquiry / password-reset emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
RECEIVER_EMAIL=support@brokerlessrealty.com

# --- Legacy MySQL vars (app currently uses SQLite; kept for reference only) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=brokerless_db
